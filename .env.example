# ------------------------------------------------------------------
# SKILLS SALOON — template. Copy to .env.local and fill in real values.
# (.env.local is gitignored; this file is safe to commit.)
# ------------------------------------------------------------------

# Supabase — public values (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OPTIONAL: only for the one-time /admin/setup bootstrap.
# The app does NOT need it: admin reads/writes use the signed-in session + RLS.
# If set, it must stay server-side only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL the QR code points to (set on Vercel in production)
NEXT_PUBLIC_SITE_URL=

# Optional: one-time /admin/setup secret (server-side only). Delete after setup.
ADMIN_SETUP_TOKEN=
